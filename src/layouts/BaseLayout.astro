---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  defaultTheme?: 'dark' | 'light';
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  type = 'website',
  publishedTime,
  noindex = false,
  defaultTheme = 'dark',
} = Astro.props;

const site = Astro.site ?? new URL('https://ollies0x.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogURL = new URL(ogImage, site);

const personJSONLD = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ollie Worthington',
  alternateName: 'Ollie',
  url: site.toString(),
  sameAs: ['https://x.com/ollies0x', 'https://github.com/ollies0x'],
  knowsAbout: ['SEO', 'AI', 'web development', 'design systems', 'local-first software'],
};

const websiteJSONLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ollies0x',
  url: site.toString(),
  author: { '@type': 'Person', name: 'Ollie Worthington' },
};

const articleJSONLD =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.toString(),
        image: ogURL.toString(),
        datePublished: publishedTime?.toISOString(),
        dateModified: publishedTime?.toISOString(),
        author: { '@type': 'Person', name: 'Ollie Worthington', url: site.toString() },
        publisher: { '@type': 'Person', name: 'Ollie Worthington' },
        mainEntityOfPage: canonical.toString(),
      }
    : null;

const pageTitle = title === 'ollies0x' ? 'ollies0x' : `${title} - ollies0x`;
---

<!doctype html>
<html lang="en-AU" data-default-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('ollies0x-theme');
          const fallback =
            document.documentElement.dataset.defaultTheme === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = stored || fallback;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogURL} />
    <meta property="og:site_name" content="ollies0x" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ollies0x" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="ollies0x" href={new URL('/rss.xml', site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personJSONLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJSONLD)} />
    {articleJSONLD && <script type="application/ld+json" set:html={JSON.stringify(articleJSONLD)} />}
    <ClientRouter />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
