---
const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'home', id: 'home' },
  { href: '/blog/', label: 'blog', id: 'blog' },
  { href: '/about/', label: 'about', id: 'about' },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/">ollies<span class="zx">0x</span></a>
    <nav class="site-nav" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={active === l.id ? 'true' : undefined}>
            {l.label}
          </a>
        ))
      }
      <button class="lights" id="theme-toggle" type="button" aria-label="Toggle lights">
        <span class="lights-label">lights: on</span>
      </button>
    </nav>
  </div>
</header>

<script>
  function initLights() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const label = btn.querySelector('.lights-label');
    const paint = () => {
      if (label)
        label.textContent =
          document.documentElement.dataset.theme === 'light' ? 'lights: off' : 'lights: on';
    };
    paint();
    btn.onclick = () => {
      const next =
        document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('ollies0x-theme', next);
      paint();
    };
  }
  initLights();
  document.addEventListener('astro:after-swap', initLights);
</script>
