---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="0x404" description="Page not found." noindex>
  <Header />
  <main class="error-page">
    <div class="wrap">
      <div class="code">0x404</div>
      <p>This page doesn't exist. It may have been deleted, or it never existed.</p>
      <p style="margin-top: 2rem"><a class="btn" href="/">go home</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
